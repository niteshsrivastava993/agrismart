# Copy to .env and fill in. See README.md "Environment variables" for what each one enables.
# Missing optional keys disable only their feature — the app still runs.

PORT=5000
CLIENT_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Required to start.
MONGODB_URI=mongodb://127.0.0.1:27017/agrismart
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Market prices (data.gov.in). Without these, Market shows "unavailable" rather than fake prices.
DATA_GOV_API_KEY=
DATA_GOV_RESOURCE_ID=

# Weather (OpenWeather).
OPENWEATHER_API_KEY=

# Password-reset email (Resend).
RESEND_API_KEY=
EMAIL_FROM=

# AI assistant (chat) and, separately, the AI crop-photo analysis microservice below both use this
# key. Get one from Google AI Studio (https://aistudio.google.com/apikey).
AI_API_KEY=
AI_MODEL=gemini-2.5-flash-lite

# python-ai-service base URL. Without this, "Analyze photo" on the Crop Health page shows an
# unavailable message instead of a fake result. See python-ai-service/README.md to run it.
PYTHON_AI_SERVICE_URL=http://localhost:8001

# Optional: demo password, and the create-admin script.
SEED_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
