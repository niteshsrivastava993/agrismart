# Copy to .env and fill in. Same Gemini API key used by server/.env's AI_API_KEY — this service
# makes its own request to the AI provider, so it needs its own copy of the key.
AI_API_KEY=

# Optional: a vision-capable model to use for photo analysis. Falls back to AI_MODEL, then to
# gemini-2.5-flash-lite, if unset.
AI_VISION_MODEL=

# Origin of the Express API allowed to call this service (CORS). Not the browser's origin.
NODE_API_ORIGIN=http://localhost:5000

PORT=8001
